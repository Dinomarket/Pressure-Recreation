import pygame
import os
WHITE   = (255, 255, 255)

class message():
    def __init__(self):
        self.char_index = 0
        self.typing_speed = 100  # Milliseconds to wait between letters
        self.last_time = pygame.time.get_ticks()
        self.font = pygame.font.Font(os.path.join('C:/Users/kinfo/OneDrive/Untitled Battle Game','assets','images',"Pokemon Classic.ttf"), 20)

    
    def displayMessage(self,message,surface):
        current_time = pygame.time.get_ticks()
        if self.char_index < len(message) and current_time - last_time >= self.typing_speed:
            current_text += message[self.char_index]
            self.char_index += 1
            last_time = current_time

        text_surface = self.font.render(current_text, True, (255, 255, 255))
        surface.blit(text_surface, (50, 50))


        

